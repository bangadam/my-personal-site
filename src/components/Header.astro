---
import ThemeToggle from "./ThemeToggle";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const active = pathname === "/posts" || pathname.startsWith("/posts/")
  ? "posts"
  : pathname === "/projects"
    ? "projects"
    : "";

const links = [
  { href: "/posts", label: "Blog", key: "posts" },
  { href: "/projects", label: "Projects", key: "projects" },
];
---

<header class="relative z-50 w-full bg-[var(--background)] py-4 transition-colors duration-[240ms]">
  <div class="mx-auto flex h-12 max-w-[672px] items-center justify-between px-6">
    <a
      href="/"
      class="brand-link flex shrink-0 items-center"
      aria-label="Home"
    >
      <img src="/site-icon.png" alt="" width="28" height="28" class="brand-icon h-7 w-7 rounded-md object-contain" />
    </a>

    <nav class="flex items-center gap-0.5" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={active === link.key ? "page" : undefined}
            class:list={[
              "nav-link inline-flex h-9 items-center rounded-md px-2.5 text-[13px]",
              active === link.key
                ? "font-medium text-[var(--foreground)]"
                : "text-[var(--muted-foreground)]",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
