---
import ThemeToggle from "./ThemeToggle";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const active = pathname === "/posts" || pathname.startsWith("/posts/")
  ? "posts"
  : pathname === "/projects"
    ? "projects"
    : "";

const links = [
  { href: "/posts", label: "Blog", key: "posts" },
  { href: "/projects", label: "Projects", key: "projects" },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[var(--background-70)] backdrop-blur-md"
>
  <div class="mx-auto flex h-14 max-w-2xl items-center justify-between px-5 sm:px-6">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2 text-sm font-medium tracking-tight"
      aria-label="Home"
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-full border border-[var(--border)] font-mono text-[11px] font-medium text-[var(--muted-foreground)] transition-colors group-hover:border-[var(--foreground)] group-hover:text-[var(--foreground)]"
      >
        a.
      </span>
    </a>

    <nav class="flex items-center gap-0.5" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={active === link.key ? "page" : undefined}
            class:list={[
              "inline-flex h-9 items-center rounded-md px-2.5 text-[13px] transition-colors",
              active === link.key
                ? "font-medium text-[var(--foreground)]"
                : "text-[var(--muted-foreground)] hover:text-[var(--foreground)]",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
