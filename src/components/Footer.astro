---
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`border-t border-[var(--border)] ${noMarginTop ? "" : "mt-12"}`}>
  <div class="flex flex-col items-center gap-3 py-6 text-center text-[12.5px] text-[var(--muted-foreground)]">
    <Socials centered />
    <p>&copy; {currentYear} Adam. Built with Astro and Tailwind.</p>
  </div>
</footer>
