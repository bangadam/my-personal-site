---
import { SOCIALS } from "@config";
import { Github, Linkedin, Mail, MessageCircle } from "lucide-react";

export interface Props {
  compact?: boolean;
  centered?: boolean;
}

const { compact = false, centered = false } = Astro.props;
const socials = SOCIALS.filter(({ active }) => active);
---

<div
  class:list={["social-links", compact && "compact", centered && "centered"]}
>
  {
    socials.map(social => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        title={social.linkTitle}
        class="social-link link-underline transition-colors hover:text-[var(--foreground)]"
      >
        <span class="social-icon">
          {social.name === "Github" && (
            <Github className="h-3.5 w-3.5" strokeWidth={1.75} />
          )}
          {social.name === "LinkedIn" && (
            <Linkedin className="h-3.5 w-3.5" strokeWidth={1.75} />
          )}
          {social.name === "Mail" && (
            <Mail className="h-3.5 w-3.5" strokeWidth={1.75} />
          )}
          {social.name === "WhatsApp" && (
            <MessageCircle className="h-3.5 w-3.5" strokeWidth={1.75} />
          )}
          {social.name === "Upwork" && (
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="h-3.5 w-3.5"
            >
              <path d="M21.2 9.5c-1.6 0-2.9.8-3.6 2.1-.4-1.1-1.4-1.8-2.6-1.8-1.4 0-2.5.6-3.2 1.7-.5-1-1.5-1.7-2.8-1.7-1 0-1.8.4-2.4 1V8.4H4.4v6.9c0 1.4 1 2.4 2.4 2.4 1.4 0 2.4-1 2.4-2.4v-2c0-.6.4-1 1-1s1 .4 1 1v2c0 1.4 1 2.4 2.4 2.4 1.4 0 2.4-1 2.4-2.4v-2c0-.6.4-1 1-1s1 .4 1 1v2c0 1.4 1 2.4 2.4 2.4 1.4 0 2.4-1 2.4-2.4v-3.2c0-1.3 1-2.3 2.3-2.3.6 0 1.1.2 1.5.6.4.4.6.9.6 1.5v3.4c0 1.4 1 2.4 2.4 2.4h.1c1.4 0 2.4-1 2.4-2.4v-3.4c0-2.4-2-4.4-4.4-4.4z" />
            </svg>
          )}
        </span>
        <span>{social.name}</span>
      </a>
    ))
  }
</div>

<style>
  .social-links {
    @apply flex flex-wrap items-center gap-x-5 gap-y-2 text-[12.5px] text-[var(--muted-foreground)];
  }

  .social-links.compact {
    @apply gap-x-3.5 gap-y-1.5 text-[12px];
  }

  .social-links.centered {
    @apply justify-center;
  }

  .social-link {
    @apply inline-flex items-center gap-1.5;
  }

  .social-icon {
    @apply inline-flex shrink-0 opacity-80;
  }
</style>
