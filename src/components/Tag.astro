---
export interface Props {
  name: string;
  size?: "sm" | "lg";
}

const { name, size = "sm" } = Astro.props;
---

<li class="inline-flex">
  <a
    href={`/tags/${name.toLowerCase()}`}
    transition:name={name.toLowerCase()}
    class:list={[
      "inline-flex items-center rounded-md border border-[var(--border)] bg-[var(--muted-40)] px-2 py-0.5 font-mono text-[var(--muted-foreground)] transition-colors hover:border-[var(--foreground-30)] hover:text-[var(--foreground)]",
      size === "sm" ? "text-[11.5px]" : "text-[13px] px-2.5 py-1",
    ]}
  >
    #{name.toLowerCase()}
  </a>
</li>
