---
export interface Props {
  name: string;
  size?: "sm" | "lg";
}

const { name, size = "sm" } = Astro.props;
---

<li class="inline-flex">
  <a
    href={`/tags/${name.toLowerCase()}`}
    class:list={[
      "tag-link font-mono text-[var(--muted-foreground)]",
      size === "sm" ? "text-[12px]" : "text-[13px]",
    ]}
  >
    #{name.toLowerCase()}
  </a>
</li>
