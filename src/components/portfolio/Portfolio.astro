---
import type { CollectionEntry } from "astro:content";
import Socials from "@components/Socials.astro";
import { CV } from "@data/cv";
import slugify from "@utils/slugify";
import { ArrowUpRight, Download } from "lucide-react";

export interface Props {
  recent: CollectionEntry<"blog">[];
}

const { recent } = Astro.props;
const { profile, roles, contacts, details, pdf } = CV;
const availability = details.find(detail => detail.label === "Availability")?.value;
const email = contacts.find(contact => contact.label === "Email");
const whatsapp = contacts.find(contact => contact.label === "WhatsApp");
---

<div class="home-profile relative isolate space-y-9 pb-12 pt-8 sm:space-y-11 sm:pb-16 sm:pt-12">
  <div class="home-ambient" aria-hidden="true"></div>
  <header class="!mt-0 flex items-center gap-[18px]">
    <img src="/avatar.png" alt="" width="56" height="56" loading="eager" class="h-14 w-14 shrink-0 rounded-full object-cover" />
    <div class="min-w-0 space-y-[3px]">
      <h1 class="text-[19px] font-normal leading-[1.35]">{profile.name}</h1>
      <p class="text-[13px] leading-[1.65] text-[var(--muted-foreground)]">{profile.title} · {profile.location}</p>
      <Socials compact />
      <div class="pt-[10px]">
        <a href={pdf.href} download class="cv-button icon-link motion-download">{pdf.label} <Download className="interaction-icon h-3.5 w-3.5" aria-hidden="true" /></a>
      </div>
    </div>
  </header>

  <section aria-labelledby="home-about">
    <h2 id="home-about" class="section-label">About</h2>
    <p class="text-[15px] leading-[1.7] text-[var(--foreground-90)]">{profile.summary}</p>
    <a href="/about" class="more-link icon-link motion-external">More about me <ArrowUpRight className="interaction-icon h-3.5 w-3.5" aria-hidden="true" /></a>
  </section>

  <section aria-labelledby="home-location">
    <h2 id="home-location" class="section-label">Location &amp; availability</h2>
    <dl class="space-y-[22px]">
      {details.map(({ label, value }) => (
        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[108px_minmax(0,1fr)] sm:gap-6">
          <dt class="text-[13px] leading-[1.65] text-[var(--muted-foreground)] sm:text-[12px]">{label}</dt>
          <dd class="min-w-0 text-[14px] leading-[1.65] text-[var(--foreground-90)] sm:text-[13px]">{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="home-work">
    <h2 id="home-work" class="section-label">Work experience</h2>
    <ol class="space-y-[22px]">
      {roles.slice(0, 3).map(role => (
        <li class="flex flex-col gap-1 sm:flex-row sm:gap-6">
          <span class="shrink-0 text-[12px] leading-[1.65] text-[var(--muted-foreground)] sm:w-[108px]">{role.period.replace(" - ", " — ")}</span>
          <div class="min-w-0">
            <h3 class="text-[14px] font-normal leading-[1.65]">{role.role} · {role.company}</h3>
            <p class="mt-1 text-[12px] leading-[1.65] text-[var(--muted-foreground)]">{role.location}</p>
          </div>
        </li>
      ))}
    </ol>
    <a href="/about#experience" class="more-link icon-link motion-external">Full experience &amp; skills <ArrowUpRight className="interaction-icon h-3.5 w-3.5" aria-hidden="true" /></a>
  </section>

  <section aria-labelledby="home-writing">
    <h2 id="home-writing" class="section-label">Writing</h2>
    {recent.length > 0 ? (
      <ol class="space-y-[22px]">
        {recent.map(({ data }) => (
          <li class="flex flex-col gap-1 sm:flex-row sm:gap-6">
            <time class="shrink-0 text-[12px] leading-[1.65] text-[var(--muted-foreground)] sm:w-[108px]" datetime={data.pubDatetime.toISOString()}>
              {data.pubDatetime.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" })}
            </time>
            <a href={`/posts/${slugify(data)}`} class="icon-link motion-external w-fit text-[15px] leading-[1.65]">{data.title} <ArrowUpRight className="interaction-icon inline h-3.5 w-3.5" aria-hidden="true" /></a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="text-[14px] text-[var(--muted-foreground)]">Writing coming soon.</p>
    )}
    <a href="/posts" class="more-link icon-link motion-external">All writing <ArrowUpRight className="interaction-icon h-3.5 w-3.5" aria-hidden="true" /></a>
  </section>

  <section aria-labelledby="home-contact">
    <h2 id="home-contact" class="section-label">Contact</h2>
    <!-- ponytail: static mascot until layered head, eye, hand, and body Lottie assets are supplied. -->
    <img src="/assets/mascot/rsmQV.webp" alt="" aria-hidden="true" width="88" height="88" loading="lazy" class="pointer-events-none mb-[22px] h-[88px] w-[88px]" />
    {availability && <p class="text-[14px] leading-[1.65] text-[var(--foreground-90)]">{availability} For hiring or project inquiries, reach me by email or WhatsApp.</p>}
    <div class="mt-[22px] flex flex-col items-start gap-1 text-[13px] leading-[1.65]">
      {email && <a href={email.href} class="icon-link motion-external">{email.value} <ArrowUpRight className="interaction-icon inline h-3.5 w-3.5" aria-hidden="true" /></a>}
      {whatsapp && <a href={whatsapp.href} target="_blank" rel="noopener noreferrer" class="icon-link motion-external">{whatsapp.value} <ArrowUpRight className="interaction-icon inline h-3.5 w-3.5" aria-hidden="true" /></a>}
      <a href={pdf.href} download class="icon-link motion-download inline-flex items-center gap-1">Download CV (PDF) <Download className="interaction-icon h-3.5 w-3.5" aria-hidden="true" /></a>
    </div>
  </section>
</div>

<style>
  .section-label {
    @apply mb-[22px] text-[13px] font-medium leading-[1.65] text-[var(--foreground)];
  }
  .more-link {
    @apply mt-[22px] inline-flex w-fit items-center gap-1 text-[13px] leading-[1.65];
  }
</style>

<script>
  import { observeAmbient } from "@utils/observeAmbient";

  document.addEventListener("astro:page-load", () => {
    const ambient = document.querySelector<HTMLElement>(".home-ambient");
    if (!ambient) return;
    const cleanup = observeAmbient(ambient);
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  });
</script>
