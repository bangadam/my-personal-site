---
import type { LucideIcon } from "lucide-react";
import {
  Bot,
  Cloud,
  Database,
  Languages,
  Layers,
  Mail,
  Network,
  Plug,
  MessageCircle,
  ShieldCheck,
} from "lucide-react";
import Socials from "@components/Socials.astro";

type Contribution = {
  date: string;
  count: number;
  level: number;
};

type ContributionResponse = {
  contributions: Contribution[];
};

type Role = {
  company: string;
  role: string;
  period: string;
  location: string;
  bullets?: string[];
  tags?: string[];
};

const roles: Role[] = [
