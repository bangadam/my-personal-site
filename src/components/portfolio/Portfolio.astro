    ],
    tags: ["Laravel", "POS"],
  },
  {
    company: "Esteh Creative",
    role: "Full Stack Developer (Contract)",
    period: "Dec 2021 - Apr 2022",
    location: "Malang, Indonesia",
    bullets: [
      "Integrated the Finpay Emoney payment system into an e-commerce website for seamless, secure transactions.",
      "Refactored legacy code and optimised data queries, making the application 30% faster and easier to maintain.",
    ],
