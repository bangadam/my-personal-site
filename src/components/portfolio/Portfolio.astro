type SkillLevel = "Expert" | "Advanced";

type SkillGroup = {
  title: string;
  icon: LucideIcon;
  skills: Array<{ name: string; level: SkillLevel }>;
};

const skillGroups: SkillGroup[] = [
  {
    title: "Languages",
    icon: Languages,
    skills: [
      { name: "PHP", level: "Expert" },
      { name: "JavaScript / TypeScript", level: "Expert" },
      { name: "SQL", level: "Expert" },
      { name: "Go", level: "Expert" },
      { name: "Python", level: "Advanced" },
    ],
  },
  {
    title: "Frameworks",
    icon: Layers,
    skills: [
      { name: "Laravel / Lumen", level: "Expert" },
      { name: "NestJS", level: "Expert" },
      { name: "ExpressJS / Fastify", level: "Expert" },
      { name: "ElysiaJS", level: "Advanced" },
      { name: "Vue.js", level: "Advanced" },
    ],
  },
  {
    title: "Databases & Caching",
    icon: Database,
    skills: [
      { name: "PostgreSQL", level: "Expert" },
      { name: "MySQL", level: "Expert" },
      { name: "Redis", level: "Expert" },
      { name: "MongoDB", level: "Advanced" },
      { name: "Firebase Firestore", level: "Advanced" },
    ],
  },
  {
    title: "API & Architecture",
    icon: Network,
    skills: [
      { name: "REST API design", level: "Expert" },
      { name: "Swagger / OpenAPI", level: "Expert" },
      { name: "GraphQL", level: "Advanced" },
      { name: "gRPC", level: "Advanced" },
      { name: "Semi-microservices, multi-tenant", level: "Advanced" },
    ],
  },
  {
    title: "AI & Agents",
    icon: Bot,
    skills: [
      { name: "MCP (Model Context Protocol)", level: "Expert" },
      { name: "AI agents & agentic workflows", level: "Expert" },
      { name: "LLM integration (OpenAI, Anthropic)", level: "Advanced" },
      { name: "RAG", level: "Advanced" },
    ],
  },
  {
    title: "Integrations",
    icon: Plug,
    skills: [
      { name: "Payments: Xendit, Midtrans, Stripe, IPay88", level: "Expert" },
      { name: "Messaging: Twilio, WhatsApp API", level: "Expert" },
      { name: "Email: Brevo, MailGun", level: "Expert" },
      { name: "Logistics: JNE, Google Maps API", level: "Advanced" },
      { name: "Realtime: Socket.IO, Firebase FCM", level: "Advanced" },
    ],
  },
  {
    title: "Cloud & DevOps",
    icon: Cloud,
    skills: [
      { name: "Docker", level: "Advanced" },
      { name: "Git (GitHub, Bitbucket)", level: "Expert" },
      { name: "GitHub Actions", level: "Advanced" },
      { name: "AWS (S3, SQS)", level: "Advanced" },
      { name: "NGINX", level: "Advanced" },
      { name: "Laravel Vapor", level: "Advanced" },
    ],
  },
  {
    title: "Auth & Quality",
    icon: ShieldCheck,
    skills: [
      { name: "OAuth2 / OIDC single sign-on", level: "Expert" },
      { name: "MFA and OTP delivery", level: "Expert" },
      { name: "RBAC", level: "Expert" },
      { name: "Query profiling & optimisation", level: "Expert" },
      { name: "PHPUnit, unit testing", level: "Advanced" },
    ],
  },
