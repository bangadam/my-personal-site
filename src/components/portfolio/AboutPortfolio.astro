---
import Socials from "@components/Socials.astro";
import { CV } from "@data/cv";
import { ArrowUpRight, Download } from "lucide-react";

const { profile, pdf, details, roles, skillGroups, contacts } = CV;
const availability = details.find(detail => detail.label === "Availability")?.value;
const email = contacts.find(contact => contact.label === "Email");
const whatsapp = contacts.find(contact => contact.label === "WhatsApp");
const companyLinks: Record<string, string> = {
  "ASABA INNOTECH": "https://asaba.co.id/",
  "KB Finansia Multi Finance": "https://www.kreditplus.com/",
  "PT Alfath Technologi Kreatif": "https://alfathtech.co.id/",
  "Esteh Creative": "https://www.esteh.id/",
  "PT Datamax Teknologi Internasional": "https://www.datamax.co.id/",
};

type Contribution = {
  date: string;
  count: number;
  level: number;
};

type ContributionResponse = {
  contributions: Contribution[];
};

let contributions: Contribution[] = [];
try {
  const response = await fetch(
    "https://github-contributions-api.jogruber.de/v4/bangadam?y=last",
    { signal: AbortSignal.timeout(5000) }
  );
  if (response.ok) {
    const data = (await response.json()) as ContributionResponse;
    contributions = data.contributions
      .sort((a, b) => a.date.localeCompare(b.date))
      .slice(-365);
  }
} catch {
  contributions = [];
}

const snapshotDate = contributions.length ? new Date().toISOString().slice(0, 10) : "";
const latestContributionDate = contributions.at(-1)?.date ?? "";
const latestMonth = latestContributionDate.slice(0, 7);
const latestYear = latestContributionDate.slice(0, 4);
const monthlyContributions = contributions
  .filter(day => day.date.startsWith(latestMonth))
  .reduce((total, day) => total + day.count, 0);
const yearlyContributions = contributions
  .filter(day => day.date.startsWith(latestYear))
  .reduce((total, day) => total + day.count, 0);
const latestMonthLabel = latestContributionDate
  ? new Intl.DateTimeFormat("en", { month: "long" }).format(
      new Date(`${latestContributionDate}T00:00:00Z`)
    )
  : "This month";

const firstWeekday = contributions.length
  ? new Date(`${contributions[0].date}T00:00:00Z`).getUTCDay()
  : 0;
const paddedDays: Array<Contribution | null> = [
  ...Array.from({ length: firstWeekday }, () => null),
  ...contributions,
];
const weeks = Array.from(
  { length: Math.ceil(paddedDays.length / 7) },
  (_, index) => paddedDays.slice(index * 7, index * 7 + 7)
);
---

<div class="pb-14 pt-10 sm:pt-14">
  <header>
    <h1 class="text-[24px] font-medium leading-[1.65] text-[var(--foreground)]">About</h1>
    <p class="mt-12 text-[16px] leading-[1.65] text-[var(--foreground-90)]">
      {profile.summary}
    </p>
    <div class="mt-5"><Socials /></div>
  </header>

  <section id="experience" class="mt-12 scroll-mt-20" aria-labelledby="work-heading">
    <h2 id="work-heading" class="section-label">Work experience</h2>
    <ol class="mt-[22px] space-y-[22px]">
      {roles.map(role => (
        <li class="grid grid-cols-1 gap-1 sm:grid-cols-[108px_minmax(0,1fr)] sm:gap-6">
          <span class="text-[12px] leading-[1.65] text-[var(--muted-foreground)]">
            {role.period.replace(" - ", " — ")}
          </span>
          <div class="min-w-0">
            <h3 class="text-[14px] font-medium leading-[1.65] text-[var(--foreground)]">
              {role.role} · {companyLinks[role.company] ? (
                <a href={companyLinks[role.company]} target="_blank" rel="noopener noreferrer" class="icon-link motion-external">
                  {role.company} <ArrowUpRight className="interaction-icon inline h-3.5 w-3.5" aria-hidden="true" />
                </a>
              ) : role.company}
            </h3>
            <p class="mt-1 text-[12px] leading-[1.65] text-[var(--muted-foreground)]">
              {role.location}
            </p>
            {role.bullets && (
              <ul class="mt-2 space-y-2">
                {role.bullets.map(bullet => (
                  <li class="text-[13px] leading-[1.65] text-[var(--foreground-90)]">{bullet}</li>
                ))}
              </ul>
            )}
            {role.tags && (
              <p class="mt-3 text-[12px] leading-[1.65] text-[var(--muted-foreground)]">
                {role.tags.join(" · ")}
              </p>
            )}
          </div>
        </li>
      ))}
      <li class="grid grid-cols-1 gap-1 sm:grid-cols-[108px_minmax(0,1fr)] sm:gap-6">
        <span class="text-[12px] leading-[1.65] text-[var(--muted-foreground)]">2023</span>
        <a href="https://bijii.co.id/" target="_blank" rel="noopener noreferrer" class="icon-link motion-external w-fit text-[14px] font-medium leading-[1.65] text-[var(--foreground)]">
          Full Stack Web Developer · Biji Inovasi <ArrowUpRight className="interaction-icon inline h-3.5 w-3.5" aria-hidden="true" />
        </a>
      </li>
      <li class="grid grid-cols-1 gap-1 sm:grid-cols-[108px_minmax(0,1fr)] sm:gap-6">
        <span class="text-[12px] leading-[1.65] text-[var(--muted-foreground)]">Since 2017</span>
        <span class="text-[13px] leading-[1.65] text-[var(--foreground-90)]">Other experience</span>
      </li>
    </ol>
  </section>

  <section class="mt-12" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="section-label">Skills</h2>
    <dl class="mt-[22px] space-y-[22px]">
      {skillGroups.map(({ title, skills }) => (
        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[108px_minmax(0,1fr)] sm:gap-6">
          <dt class="text-[12px] leading-[1.65] text-[var(--muted-foreground)]">{title}</dt>
          <dd class="min-w-0">
            <ul class="space-y-1.5">
              {skills.map(({ name, level }) => (
                <li class="text-[13px] leading-[1.65] text-[var(--foreground-90)]">
                  {name} · {level.toLowerCase()}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
      <div class="grid grid-cols-1 gap-1 sm:grid-cols-[108px_minmax(0,1fr)] sm:gap-6">
        <dt class="text-[12px] leading-[1.65] text-[var(--muted-foreground)]">Other tools</dt>
        <dd class="min-w-0 text-[13px] leading-[1.65] text-[var(--foreground-90)]">
          Nuxt.js · Tailwind CSS · Bootstrap · HTML · CSS
        </dd>
      </div>
    </dl>
  </section>

  <section class="mt-12" aria-labelledby="location-heading">
    <h2 id="location-heading" class="section-label">Location &amp; availability</h2>
    <dl class="mt-[22px] space-y-[22px]">
      {details.map(({ label, value }) => (
        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[108px_minmax(0,1fr)] sm:gap-6">
          <dt class="text-[12px] leading-[1.65] text-[var(--muted-foreground)]">{label}</dt>
          <dd class="min-w-0 text-[13px] leading-[1.65] text-[var(--foreground-90)]">
            {value}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-12" aria-labelledby="contributions-heading">
    <h2 id="contributions-heading" class="section-label">GitHub contributions</h2>
    {contributions.length > 0 ? (
      <>
        <p class="mt-[22px] text-[12px] leading-[1.65] text-[var(--muted-foreground)]">
          {latestMonthLabel}: {monthlyContributions.toLocaleString()} · {latestYear}: {yearlyContributions.toLocaleString()} · Build snapshot: <time datetime={snapshotDate}>{snapshotDate}</time>
        </p>
        <a
          href="https://github.com/bangadam"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-[22px] block"
          aria-label="View bangadam's GitHub contributions"
        >
          <div class="gh-grid" aria-hidden="true">
            {weeks.map(week =>
              week.map(day =>
                day ? (
                  <span
                    class={`gh-cell gh-level-${day.level}`}
                    title={`${day.date}: ${day.count} contribution${day.count === 1 ? "" : "s"}`}
                  />
                ) : (
                  <span class="gh-cell gh-empty" />
                )
              )
            )}
          </div>
        </a>
        <details class="mt-3 text-[12px] leading-[1.65] text-[var(--muted-foreground)]">
          <summary class="link-underline w-fit cursor-pointer">Daily contribution counts</summary>
          <ul class="mt-3 max-h-48 space-y-1 overflow-y-auto" aria-label="Daily GitHub contributions in the last year" tabindex="0">
            {contributions.map(day => (
              <li><time datetime={day.date}>{day.date}</time>: {day.count} contribution{day.count === 1 ? "" : "s"}</li>
            ))}
          </ul>
        </details>
      </>
    ) : (
      <a
        href="https://github.com/bangadam"
        target="_blank"
        rel="noopener noreferrer"
        class="link-underline mt-[22px] inline-block text-[13px] text-[var(--muted-foreground)]"
      >
        View GitHub activity
      </a>
    )}
  </section>

  <section class="mt-12" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="section-label">Contact</h2>
    {availability && (
      <p class="mt-[22px] text-[14px] leading-[1.65] text-[var(--foreground-90)]">
        {availability} For hiring or project inquiries, reach me by email or WhatsApp.
      </p>
    )}
    <div class="mt-[22px] flex flex-col items-start gap-1 text-[13px] leading-[1.65] text-[var(--foreground)]">
      {email && <a href={email.href} class="icon-link motion-external">{email.value} <ArrowUpRight className="interaction-icon inline h-3.5 w-3.5" aria-hidden="true" /></a>}
      {whatsapp && (
        <a href={whatsapp.href} target="_blank" rel="noopener noreferrer" class="icon-link motion-external">
          {whatsapp.value} <ArrowUpRight className="interaction-icon inline h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )}
      <a href={pdf.href} download class="icon-link motion-download inline-flex items-center gap-1">Download CV (PDF) <Download className="interaction-icon h-3.5 w-3.5" aria-hidden="true" /></a>
    </div>
  </section>
</div>

<style>
  .section-label {
    @apply text-[13px] font-medium leading-[1.65] text-[var(--foreground)];
  }

  .gh-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 1fr);
    grid-auto-columns: 1fr;
    gap: 2px;
    width: 100%;
    aspect-ratio: 53 / 7;
  }

  .gh-cell {
    border-radius: 2px;
    transition: outline-color 120ms ease;
  }

  .gh-cell:hover {
    outline: 1px solid var(--foreground);
    outline-offset: 1px;
  }

  .gh-empty,
  .gh-level-0 {
    background: var(--muted);
  }

  .gh-level-1 {
    background: #c9c9c9;
  }
  .gh-level-2 {
    background: #9a9a9a;
  }
  .gh-level-3 {
    background: #5c5c5c;
  }
  .gh-level-4 {
    background: #1f1f1f;
  }

  :global(.dark) .gh-empty,
  :global(.dark) .gh-level-0 {
    background: #1a1a1a;
  }
  :global(.dark) .gh-level-1 {
    background: #3a3a3a;
  }
  :global(.dark) .gh-level-2 {
    background: #6b6b6b;
  }
  :global(.dark) .gh-level-3 {
    background: #a8a8a8;
  }
  :global(.dark) .gh-level-4 {
    background: #e5e5e5;
  }
</style>
