---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Card from "@components/Card";
import slugify from "@utils/slugify";
import type { CollectionEntry } from "astro:content";

export interface Props {
  pageNum: number;
  totalPages: number;
  posts: CollectionEntry<"blog">[];
}

const { pageNum, totalPages, posts } = Astro.props;

const prevDisabled = pageNum <= 1;
const nextDisabled = pageNum >= totalPages;
---

<Layout title={`Posts | ${SITE.title}`}>
  <Main pageTitle="Posts" pageDesc="All the articles I've posted.">
    <ul class="space-y-7">
      {posts.map(({ data }) => (
        <Card href={`/posts/${slugify(data)}`} frontmatter={data} />
      ))}
    </ul>
  </Main>

  {
    totalPages > 1 && (
      <nav class="mt-8 flex items-center justify-between" aria-label="Pagination">
        <a
          href={prevDisabled ? undefined : pageNum - 1 !== 1 ? `/posts/${pageNum - 1}` : "/posts"}
          aria-disabled={prevDisabled ? "true" : undefined}
          tabindex={prevDisabled ? -1 : undefined}
          class:list={["pagination-link motion-prev inline-flex items-center gap-1 font-mono text-[13px] text-[var(--muted-foreground)]", prevDisabled && "disabled"]}
        >
          <span class="interaction-icon" aria-hidden="true">&larr;</span> Prev
        </a>
        <span class="font-mono text-[12.5px] text-[var(--muted-foreground)]">
          {pageNum} / {totalPages}
        </span>
        <a
          href={nextDisabled ? undefined : `/posts/${pageNum + 1}`}
          aria-disabled={nextDisabled ? "true" : undefined}
          tabindex={nextDisabled ? -1 : undefined}
          class:list={["pagination-link motion-next inline-flex items-center gap-1 font-mono text-[13px] text-[var(--muted-foreground)]", nextDisabled && "disabled"]}
        >
          Next <span class="interaction-icon" aria-hidden="true">&rarr;</span>
        </a>
      </nav>
    )
  }
</Layout>

<style>
  .disabled {
    @apply pointer-events-none opacity-40;
  }
</style>
