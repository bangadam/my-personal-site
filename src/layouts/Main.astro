---
interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;
---

<div class="pt-10 sm:pt-14">
  {
    "titleTransition" in props ? (
      <h1 class="text-[28px] font-semibold leading-tight tracking-[-0.02em] text-[var(--foreground)] sm:text-[34px]">
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class="text-[28px] font-semibold leading-tight tracking-[-0.02em] text-[var(--foreground)] sm:text-[34px]">
        {props.pageTitle}
      </h1>
    )
  }
  {props.pageDesc && (
    <p class="mb-6 mt-2 text-[14.5px] text-[var(--muted-foreground)]">
      {props.pageDesc}
    </p>
  )}
  <slot />
</div>
