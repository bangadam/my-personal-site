---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import results from "../../../public/data.json";

const StringToArray = (str: string) => str.split(";").map(item => item.trim());
---

<Layout title={`AllGpt Resources | ${SITE.title}`}>
  <Main pageTitle="All GPT" pageDesc="All gpt resources you need">
    <div class="grid gap-3 sm:grid-cols-2">
      {
        results.map(({ title, url, text, category }) => (
          <div class="row-hover rounded-md border border-[var(--border)] bg-[var(--card)] p-5">
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[15px] font-medium text-[var(--foreground)]"
            >
              {title}
            </a>
            <p class="mt-2 text-[14px] leading-[1.6] text-[var(--muted-foreground)]">
              {text}
            </p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {StringToArray(category).map(item => (
                <span class="inline-flex items-center rounded-md border border-[var(--border)] bg-[var(--muted-40)] px-2 py-0.5 font-mono text-[11.5px] text-[var(--muted-foreground)]">
                  #{item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Main>
</Layout>
