---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 - Adam" description="Page not found.">
  <section class="flex min-h-[60vh] flex-col items-start justify-center gap-6 pt-12 pb-16">
    <div class="font-mono text-[12px] uppercase tracking-[0.12em] text-[var(--muted-foreground)]">
      Error 404
    </div>
    <h1 class="text-[36px] font-semibold leading-[1.05] tracking-[-0.025em] text-[var(--foreground)] sm:text-[48px]">
      Lost in the stack trace.
    </h1>
    <p class="max-w-md text-[16px] leading-[1.6] text-[var(--muted-foreground)]">
      Whatever you were looking for is not here. Could be a broken link, could be a
      typo. Either way, the back button is your friend.
    </p>
    <pre
      class="overflow-x-auto rounded-md border border-[var(--border)] bg-[var(--card)] p-4 font-mono text-[12px] leading-[1.4] text-[var(--muted-foreground)]"
    >{`> curl -I {url}
HTTP/1.1 404 Not Found
x-powered-by: Cloudflare
content-type: text/html; charset=utf-8
> _
`}</pre>
    <a
      href="/"
      class="link-underline inline-flex items-center gap-1 text-[15px] font-medium text-[var(--foreground)]"
    >
      Back to home <span aria-hidden="true">&rarr;</span>
    </a>
  </section>
</Layout>
